TYPE
  OTA_RESULT : (OTA_OK, OTA_PENDING, OTA_BUSY, OTA_INVALID_ARGUMENT, OTA_NOT_READY, OTA_NO_MEMORY, OTA_UNSUPPORTED, OTA_IO_ERROR, OTA_WRONG_BOARD, OTA_TOO_LARGE, OTA_SAME_VERSION, OTA_DOWNGRADE, OTA_UNSIGNED, OTA_BAD_SIGNATURE, OTA_REFUSED, OTA_TIMEOUT, OTA_BAD_CHUNK, OTA_HASH_MISMATCH, OTA_BAD_IMAGE, OTA_ABORTED, OTA_ROLLED_BACK, OTA_NOT_CONFIRMED) := OTA_OK;
END_TYPE
