TYPE
  ST_OtaSigningConfig : STRUCT
    sPublicKey : STRING(130); (* the P-256 public key, 128 hex characters as `modbee_ota.py pubkey` prints it (see docs: Signing); empty = no signature check *)
    bRequireSignedFirmware : BOOL; (* refuse every update until sPublicKey holds a valid key, then every unsigned one *)
  END_STRUCT;
END_TYPE
