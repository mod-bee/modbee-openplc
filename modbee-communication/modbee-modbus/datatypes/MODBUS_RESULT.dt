TYPE
  MODBUS_RESULT : (MODBUS_QUEUED, MODBUS_OK, MODBUS_NOT_INITIALISED, MODBUS_INVALID_ARGUMENT, MODBUS_NOT_MAPPED, MODBUS_DUPLICATE, MODBUS_QUEUE_FULL, MODBUS_UNKNOWN_UNIT, MODBUS_SUPERSEDED, MODBUS_CANCELLED, MODBUS_TIMEOUT, MODBUS_REFUSED, MODBUS_ACKNOWLEDGED, MODBUS_BUSY, MODBUS_GATEWAY_PATH_UNAVAILABLE, MODBUS_GATEWAY_TARGET_FAILED, MODBUS_LINK_DOWN, MODBUS_CHECKSUM_ERROR, MODBUS_PROTOCOL_ERROR, MODBUS_WRONG_TASK) := MODBUS_OK;
END_TYPE
