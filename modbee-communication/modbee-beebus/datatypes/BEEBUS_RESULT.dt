TYPE
  BEEBUS_RESULT : (BEEBUS_QUEUED, BEEBUS_OK, BEEBUS_NOT_INITIALISED, BEEBUS_INVALID_ARGUMENT, BEEBUS_UNKNOWN_NODE, BEEBUS_DUPLICATE_NODE_ID, BEEBUS_NOT_MAPPED, BEEBUS_DUPLICATE, BEEBUS_QUEUE_FULL, BEEBUS_TIMEOUT, BEEBUS_NODE_LOST, BEEBUS_SUPERSEDED, BEEBUS_CANCELLED, BEEBUS_REFUSED, BEEBUS_TYPE_MISMATCH, BEEBUS_NOT_SUBSCRIBED, BEEBUS_BUFFER_FULL, BEEBUS_WRONG_TASK) := BEEBUS_OK;
END_TYPE
