TYPE
  ST_GsmSmsConfig : STRUCT
    nMaxPendingSms : INT := 8; (* SendSms's queue: messages (a number and its text) waiting, 1 to 64 *)
    nMaxSmsPerHour : INT := 10; (* messages SendSms queues an hour, every number counted; 0 = no limit *)
    nRetriesBeforeDrop : INT := 1; (* a failed send is tried again this many times, then dropped *)
    tRetryAfter : TIME := T#60s; (* how long before it is tried again *)
  END_STRUCT;
END_TYPE
