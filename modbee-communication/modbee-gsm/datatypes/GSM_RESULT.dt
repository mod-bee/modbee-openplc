TYPE
  GSM_RESULT : (GSM_QUEUED, GSM_OK, GSM_NOT_INITIALISED, GSM_INVALID_ARGUMENT, GSM_NOT_READY, GSM_NO_BEARER, GSM_NO_SOCKET_AVAILABLE, GSM_QUEUE_FULL, GSM_SUPERSEDED, GSM_CANCELLED, GSM_TOO_LARGE, GSM_NOT_SUPPORTED_BY_MODULE, GSM_ERROR, GSM_MODULE_ERROR, GSM_TIMEOUT, GSM_SOCKET_CLOSED, GSM_BEARER_LOST, GSM_UNRESPONSIVE, GSM_POWERED_OFF, GSM_REGISTRATION_DENIED) := GSM_OK;
END_TYPE
