TYPE
  MQTT_RESULT : (MQTT_QUEUED, MQTT_OK, MQTT_NOT_INITIALISED, MQTT_INVALID_ARGUMENT, MQTT_INVALID_TOPIC, MQTT_NOT_CONNECTED, MQTT_QUEUE_FULL, MQTT_DUPLICATE, MQTT_SUPERSEDED, MQTT_CANCELLED, MQTT_NOT_SUPPORTED_BY_PROTOCOL, MQTT_NOT_SUPPORTED_BY_PEER, MQTT_PACKET_TOO_LARGE, MQTT_QUOTA_EXCEEDED, MQTT_NO_PACKET_IDENTIFIER, MQTT_REFUSED, MQTT_NO_MATCHING_SUBSCRIBERS, MQTT_TOPIC_NAME_INVALID, MQTT_NOT_AUTHORIZED, MQTT_PAYLOAD_FORMAT_INVALID, MQTT_QUOTA_EXCEEDED_BY_PEER, MQTT_PACKET_IDENTIFIER_IN_USE, MQTT_CONNECTION_LOST, MQTT_SESSION_LOST, MQTT_CONNECTION_REFUSED, MQTT_PROTOCOL_ERROR, MQTT_MALFORMED_PACKET, MQTT_KEEPALIVE_TIMEOUT, MQTT_ACK_TIMEOUT, MQTT_SESSION_TAKEN_OVER, MQTT_WRONG_TASK) := MQTT_OK;
END_TYPE
