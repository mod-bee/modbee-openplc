# Local development material (sources, tests, tools, notes): not published.
internal/
temp/

# Build output. The .stlib is produced from source by `openplc-cli library
# build`, so committing it would mean two sources of truth for the same blocks.
build/
# Built board packages (.vpp, from node-vpp/build-vpp.mjs).
dist/
# Release output of tools/build-release.mjs.
/release/

# Python caches.
__pycache__/
*.pyc

# Keys: only public halves are published (the VPP signing key's private half
# lives outside the repo).
*.pem
!*.pub.pem

# Local tool and editor state.
CLAUDE.md
AGENTS.md
.claude/
.kilo/
.vscode/
.idea/
.DS_Store

# Library sources fetched from GitHub by tools/fetch-sources.mjs, at the
# repository and tag each library's sources.json pins. The pin is the source
# of truth; resources/ folders not listed in a sources.json stay committed.
modbee-communication/modbee-beebus/resources/modbee-beebus/
modbee-communication/modbee-gsm/resources/modbee-gsm/
modbee-communication/modbee-modbus/resources/modbee-modbus/
modbee-communication/modbee-mqtt/resources/modbee-mqtt/
modbee-communication/modbee-ota/resources/modbee-ota/
modbee-hardware/modbee-hardware-arduino/modbee-node-uio/node-uio/resources/node-uio/
modbee-hardware/modbee-hardware-arduino/modbee-node-uio/node-webUI/resources/node-webUI/
modbee-hardware/modbee-hardware-arduino/modbee-node-uio/node-webUI/resources/ArduinoJson/
modbee-hardware/modbee-hardware-arduino/modbee-node-uio/node-webUI/resources/AsyncTCP/
modbee-hardware/modbee-hardware-arduino/modbee-node-uio/node-webUI/resources/ESPAsyncWebServer/
