TYPE
  ST_SeqStep : STRUCT
    bFeedback : BOOL; (* running / proven *)
    bReady : BOOL := TRUE; (* healthy, could start *)
    bCmd : BOOL; (* run this machine *)
    eState : E_SeqStepState;
    tElapsed : TIME;
    tLeft : TIME; (* its timeout while starting or stopping, its delay while the chain waits on it *)
  END_STRUCT;
END_TYPE
