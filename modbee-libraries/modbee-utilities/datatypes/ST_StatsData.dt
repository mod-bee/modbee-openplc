TYPE
  ST_StatsData : STRUCT
    bCmdClearPeriods : BOOL; (* clear the current and previous period (cleared; a held write acts once) *)
    set : ST_StatsSet; (* settings (kept) *)
    sts : ST_StatsSts; (* status *)
    tot : ST_StatsTot; (* kept hourly and at each rollover / reset *)
  END_STRUCT;
END_TYPE
