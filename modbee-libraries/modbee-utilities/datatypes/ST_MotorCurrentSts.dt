TYPE
  ST_MotorCurrentSts : STRUCT
    fCurrent : REAL; (* in the CT's unit *)
    fPercent : REAL; (* of full load *)
    bProvesRun : BOOL;
    stHigh : ST_ProtectionSts;
    stLow : ST_ProtectionSts;
    stStartTooLong : ST_ProtectionSts;
    stBad : ST_ProtectionSts;
    bRefused : BOOL;
    eRefusedWhy : E_UtError; (* why the last write was refused (cleared with bRefused) *)
    tMaskLeft : TIME; (* running: the start mask's time left (0 when past it or stopped) *)
  END_STRUCT;
END_TYPE
