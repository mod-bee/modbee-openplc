TYPE
  ST_MsgQueueSts : STRUCT
    nCount : INT;
    bFull : BOOL;
    nLost : UDINT;
    bWrnConfig : BOOL; (* no slot or no source *)
    bWrnSrc : BOOL; (* a call this scan had an nSrc outside aSources (ignored) *)
    bRefused : BOOL;
    eRefusedWhy : E_UtError; (* why the last write was refused (cleared with bRefused) *)
  END_STRUCT;
END_TYPE
