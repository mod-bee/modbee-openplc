TYPE
  ST_EventLogSts : STRUCT
    stLast : ST_Event; (* the newest event *)
    nEvents : INT;
    nLogged : UDINT;
    nLost : UDINT;
    bWrnConfig : BOOL; (* aBuffer has no element, or more than 16 while kept *)
    bWrnSrc : BOOL; (* a call this scan had an nSrc outside aSources (ignored) *)
    bRefused : BOOL;
  END_STRUCT;
END_TYPE
