TYPE
  ST_RegisterMeterData : STRUCT
    bCmdResetTotal : BOOL; (* the total back to 0 (cleared by the block) *)
    set : ST_RegisterMeterSet;
    sts : ST_RegisterMeterSts;
    tot : ST_RegisterMeterTot;
    bCmdConfirm : BOOL; (* confirms bCmdResetTotal (set.bConfirmReset); cleared by the block *)
    bCmdPreset : BOOL; (* the total to fPresetTotal (cleared by the block) *)
    fPresetTotal : LREAL;
  END_STRUCT;
END_TYPE
