TYPE
  ST_DigitalInSts : STRUCT
    bQ : BOOL;
    bAlarm : BOOL;
    bChatter : BOOL;
    bGood : BOOL;
    bRefused : BOOL; (* a bad settings write was put back (cleared by a reset) *)
    eRefusedWhy : E_UtError; (* why the last write was refused (cleared with bRefused) *)
  END_STRUCT;
END_TYPE
