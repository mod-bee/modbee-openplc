TYPE
  ST_ValveSet EXTENDS ST_EquipmentSet : STRUCT
    eValveType : E_ValveType; (* the valve kind: SpringNc, SpringNo or DoubleHeld *)
    eSafePosition : E_SafePos; (* where it goes on Off, the interlock or a trip: Closed or Open *)
    tOpenStrokeTime : TIME := T#5s; (* travel time (also the end switch timeout base) *)
    tCloseStrokeTime : TIME := T#5s; (* travel time to close (also the end switch timeout base) *)
    bOpenLimitSwitchFitted : BOOL; (* the open end switch (bOpenLimitSwitch) is fitted and used *)
    bClosedLimitSwitchFitted : BOOL; (* the closed end switch (bClosedLimitSwitch) is fitted and used *)
    stStrokeTimeoutFault : ST_ProtectionSet := (eActionOnFault := E_Response.Trip, tTripDelay := T#0s, eResetMode := E_ResetMode.Retry, tAutoRecoverAfter := T#10s, nMaxRetriesBeforeLockout := 3);
    stBothLimitsFault : ST_ProtectionSet := (eActionOnFault := E_Response.Trip, tTripDelay := T#1s, eResetMode := E_ResetMode.Manual, tAutoRecoverAfter := T#0s, nMaxRetriesBeforeLockout := 0);
    stPositionLostFault : ST_ProtectionSet := (eActionOnFault := E_Response.Warn, tTripDelay := T#2s, eResetMode := E_ResetMode.Auto, tAutoRecoverAfter := T#2s, nMaxRetriesBeforeLockout := 0);
    tSlowStrokeAbove : TIME; (* a stroke slower than this warns (0 = off; needs the end switch) *)
    stSlowStrokeFault : ST_ProtectionSet := (eActionOnFault := E_Response.Warn, tTripDelay := T#0s, eResetMode := E_ResetMode.Auto, tAutoRecoverAfter := T#0s, nMaxRetriesBeforeLockout := 3);
    stActuatorInLocalFault : ST_ProtectionSet := (eActionOnFault := E_Response.Warn, tTripDelay := T#2s, eResetMode := E_ResetMode.Auto, tAutoRecoverAfter := T#2s, nMaxRetriesBeforeLockout := 3);
    stNoMovementFault : ST_ProtectionSet := (eActionOnFault := E_Response.Off, tTripDelay := T#2s, eResetMode := E_ResetMode.Retry, tAutoRecoverAfter := T#1m, nMaxRetriesBeforeLockout := 3);
  END_STRUCT;
END_TYPE
