TYPE
  ST_DigitalInData : STRUCT
    bCmdResetFaults : BOOL; (* reset a Manual alarm, clear bSettingRefused (cleared by the block) *)
    bCmdResetTotals : BOOL; (* clear the totals (cleared by the block) *)
    set : ST_DigitalInSet; (* settings (kept) *)
    sts : ST_DigitalInSts; (* status *)
    det : ST_DigitalInDet; (* details *)
    tot : ST_DigitalInTot; (* totals (kept) *)
  END_STRUCT;
END_TYPE
