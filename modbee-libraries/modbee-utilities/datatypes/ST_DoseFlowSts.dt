TYPE
  ST_DoseFlowSts EXTENDS ST_DoseSts : STRUCT
    bCarrierProven : BOOL; (* the carrier is proven *)
    fDoseRateNeeded : REAL; (* dose units per hour *)
    fRatioInUse : REAL; (* the dose ratio this run uses *)
    stOverCapacityFault : ST_ProtectionSts; (* the dose needs more than the pump gives (a trip holds the dose) *)
  END_STRUCT;
END_TYPE
