TYPE
  ST_LevelFloatsData : STRUCT
    bCmdResetTransducerFault : BOOL; (* clear the transducer fault (cleared by the block) *)
    set : ST_LevelFloatsSet; (* settings (kept) *)
    sts : ST_LevelFloatsSts; (* status *)
    tot : ST_LevelFloatsTot; (* totals (kept) *)
    bCmdResetTotals : BOOL; (* zero tot (cleared by the block) *)
  END_STRUCT;
END_TYPE
