TYPE
  ST_MotorSts EXTENDS ST_EquipmentSts : STRUCT
    stOverloadFault : ST_ProtectionSts; (* overload relay tripped *)
    stNoRunFeedbackFault : ST_ProtectionSts; (* the run feedback never came after a start *)
    stRunFeedbackLostFault : ST_ProtectionSts; (* the run feedback went while running *)
    stStuckOnFault : ST_ProtectionSts; (* the run feedback stays after a stop (contactor stuck) *)
  END_STRUCT;
END_TYPE
