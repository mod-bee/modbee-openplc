TYPE
  ST_MotorCurrentSet : STRUCT
    fFullLoadCurrent : REAL; (* full-load current, in the CT's unit (0 = no monitoring) *)
    fProvesRunAbovePct : REAL := 20.0; (* bCurrentProvesRun at or above this % of full load *)
    tMaskAfterStart : TIME := T#5s; (* high / low wait this long after the motor runs *)
    stHighCurrentFault : ST_CurrentLevelSet := (eActionOnFault := E_Response.Off, tTripDelay := T#5s, eResetMode := E_ResetMode.Retry, tAutoRecoverAfter := T#5m, nMaxRetriesBeforeLockout := 3, fLevelPct := 115.0, fClearDeadbandPct := 5.0);
    stLowCurrentFault : ST_CurrentLevelSet := (eActionOnFault := E_Response.Off, tTripDelay := T#5s, eResetMode := E_ResetMode.Retry, tAutoRecoverAfter := T#5m, nMaxRetriesBeforeLockout := 3, fLevelPct := 40.0, fClearDeadbandPct := 5.0);
    stLockedRotorFault : ST_CurrentLevelSet := (eActionOnFault := E_Response.Off, tTripDelay := T#15s, eResetMode := E_ResetMode.Manual, fLevelPct := 150.0, fClearDeadbandPct := 0.0);
    stCurrentBadFault : ST_ProtectionSet := (eActionOnFault := E_Response.Warn, tTripDelay := T#5s, eResetMode := E_ResetMode.Auto, tAutoRecoverAfter := T#10s, nMaxRetriesBeforeLockout := 3);
    tRetryCountWindow : TIME := T#1h; (* a Retry protection counts its trips within this window (0 = until a reset) *)
  END_STRUCT;
END_TYPE
