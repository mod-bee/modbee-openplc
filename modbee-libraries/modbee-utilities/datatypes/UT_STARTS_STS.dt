TYPE
  UT_STARTS_STS : STRUCT
    statusCode : UT_STATUS;
    faultId : UT_FAULT;
    statusText : STRING(30);
    refused : UT_FAULT;
    refusedWhy : UT_FAULT;
    ne107 : UT_NE107;
    lastHour : INT; (* starts in the window *)
    startsLeft : INT; (* -1: no limit *)
    startPermit : BOOL;
    configBad : BOOL;
  END_STRUCT;
END_TYPE
