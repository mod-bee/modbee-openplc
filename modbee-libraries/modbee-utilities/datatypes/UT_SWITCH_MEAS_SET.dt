TYPE
  UT_SWITCH_MEAS_SET : STRUCT
    useLL : BOOL; (* LL switch fitted *)
    useL : BOOL;
    useH : BOOL;
    useHH : BOOL;
    debounce : TIME := T#2s; (* a switch must hold its new state this long *)
    disagree : UT_PROTECTION := (response := UT_RESP_WARN, delay := T#10s, reset := UT_RST_AUTO, recover := T#10s);
    inputBad : UT_PROTECTION := (response := UT_RESP_TRIP, delay := T#5s, reset := UT_RST_AUTO, recover := T#10s);
    retryWindow : TIME := T#1h;
    unit : UT_UNIT; (* what the switches measure *)
  END_STRUCT;
END_TYPE
