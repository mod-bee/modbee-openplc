TYPE
  UT_SYSTEM_MODE_STS : STRUCT
    statusCode : UT_STATUS;
    faultId : UT_FAULT;
    statusText : STRING(30);
    refused : UT_FAULT;
    refusedWhy : UT_FAULT;
    ne107 : UT_NE107;
    stopReason : UT_STOP; (* why the last manual run ended *)
    mode : UT_SYS_MODE;
    autoType : INT;
    manualRun : BOOL;
    powerUpHold : BOOL;
    warning : BOOL;
  END_STRUCT;
END_TYPE
