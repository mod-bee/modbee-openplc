TYPE
  ST_ValveFloatSet : STRUCT
    tFullStrokeTime : TIME := T#60s; (* full stroke *)
    tShortestMove : TIME := T#500ms; (* shortest move *)
    tExtraDriveAtEnd : TIME := T#5s; (* extra drive at 0 / 100 % to re-sync *)
    tReversingDeadTime : TIME := T#500ms; (* pause between raise and lower *)
    bHomeAtPowerUp : BOOL := TRUE; (* home at power-up *)
  END_STRUCT;
END_TYPE
