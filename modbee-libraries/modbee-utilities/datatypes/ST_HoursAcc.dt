TYPE
  ST_HoursAcc : STRUCT
    tLastScanAt : TIME; (* engine memory: TIME() at the last scan *)
    tUncountedRemainder : TIME; (* part of a millisecond not yet counted *)
    bRunningLastScan : BOOL; (* engine memory: running on the last scan *)
    bStarted : BOOL; (* engine memory: the first scan has been seen *)
  END_STRUCT;
END_TYPE
