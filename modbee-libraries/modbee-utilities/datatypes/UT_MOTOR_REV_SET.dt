TYPE
  UT_MOTOR_REV_SET : STRUCT
    reversalDelay : TIME := T#2s;
    stopBeforeReverse : BOOL; (* a direction change stops first; a new start needed *)
    changeoverTime : TIME := T#2s;
    changeover : UT_PROTECTION := (response := UT_RESP_TRIP, delay := T#0s, reset := UT_RST_MANUAL);
  END_STRUCT;
END_TYPE
