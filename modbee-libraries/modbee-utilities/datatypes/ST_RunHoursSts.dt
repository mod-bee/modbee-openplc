TYPE
  ST_RunHoursSts : STRUCT
    fHours : LREAL; (* lifetime *)
    fServiceHours : LREAL; (* since the last service *)
    fServiceLeft : LREAL;
    bServiceDue : BOOL;
    tLastRun : TIME; (* written at each run end *)
    bRefused : BOOL;
    eRefusedWhy : E_UtError; (* why the last write was refused (cleared with bRefused) *)
  END_STRUCT;
END_TYPE
