TYPE
  UT_INTLK_STS : STRUCT
    statusCode : UT_STATUS;
    faultId : UT_FAULT;
    statusText : STRING(30);
    refused : UT_FAULT;
    refusedWhy : UT_FAULT;
    ne107 : UT_NE107;
    ok : BOOL;
    firstOut : INT;
    bypassed : BOOL;
    notOkCount : INT;
    statusCond : INT; (* the condition the status is about (0 = none) *)
    warning : BOOL;
    trips : UDINT;
  END_STRUCT;
END_TYPE
