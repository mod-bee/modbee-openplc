TYPE
  ST_ZoneSts : STRUCT
    bWatering : BOOL;
    bOpen : BOOL;
    bDone : BOOL;
    tWatered : TIME;
    fWatered : LREAL;
    tTimeLeft : TIME;
    nCycle : INT; (* cycles finished *)
    bSoaking : BOOL;
    tSoakLeft : TIME;
    bFlowTrip : BOOL; (* the flow check has taken the zone out *)
    bCapped : BOOL; (* the last cycle ended on its time cap *)
    stFlowCheck : ST_ProtectionSts;
    bRefused : BOOL;
  END_STRUCT;
END_TYPE
