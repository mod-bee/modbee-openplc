TYPE
  ST_ZoneSeqSts : STRUCT
    eState : E_State;
    eErrorId : E_UtError;
    ePhase : E_ZonePhase;
    nZone : INT;
    bActive : BOOL;
    eStopReason : E_StopReason;
    nRunZone : INT; (* the one zone of this run (0 = the program) *)
    nPass : INT; (* the pass running *)
    bRainHold : BOOL;
    bMasterWanted : BOOL;
    bDoseOn : BOOL;
    tPumpWait : TIME; (* the time with no water for want of the pump *)
    bRefused : BOOL;
    eRefusedWhy : E_UtError; (* why the last write was refused (cleared with bRefused) *)
    bPaused : BOOL; (* held (bPause, bCmdPause, a rain pause, a resume wait) *)
    nRuns : UDINT; (* programs started since power-up *)
    fDelivered : LREAL; (* this program's water (the meter) *)
  END_STRUCT;
END_TYPE
