TYPE
  ST_ProtectionWork : STRUCT
    tCauseSince : TIME;
    tGoneSince : TIME;
    tWindowStart : TIME;
    bCausePrev : BOOL;
    bActivePrev : BOOL;
    bActive : BOOL;
    bLatched : BOOL;
    bNeedsReset : BOOL;
    bTrip : BOOL;
    bWarn : BOOL;
    bSignal : BOOL;
    bReset : BOOL; (* a reset that was needed happened this scan *)
    bCleared : BOOL; (* an operator reset cleared an AUTO / RETRY latch early this scan *)
    bBadSetting : BOOL;
  END_STRUCT;
END_TYPE
