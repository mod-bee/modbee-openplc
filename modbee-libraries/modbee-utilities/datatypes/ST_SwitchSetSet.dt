TYPE
  ST_SwitchSetSet : STRUCT
    bSensorFitted : BOOL := TRUE; (* FALSE: not on this site (not good, no fault) *)
    stSwitchOrderFault : ST_ProtectionSet := (eActionOnFault := E_Response.Warn, tTripDelay := T#10s, eResetMode := E_ResetMode.Auto, tAutoRecoverAfter := T#10s, nMaxRetriesBeforeLockout := 3);
    stInputBadFault : ST_ProtectionSet := (eActionOnFault := E_Response.Trip, tTripDelay := T#5s, eResetMode := E_ResetMode.Auto, tAutoRecoverAfter := T#10s, nMaxRetriesBeforeLockout := 3);
    tRetryCountWindow : TIME := T#1h; (* a Retry protection counts its trips within this window (0 = until a reset) *)
  END_STRUCT;
END_TYPE
