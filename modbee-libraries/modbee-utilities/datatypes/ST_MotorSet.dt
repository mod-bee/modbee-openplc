TYPE
  ST_MotorSet EXTENDS ST_EquipmentSet : STRUCT
    tRestartDelay : TIME := T#5s; (* after a stop, before the next start *)
    bUseFeedback : BOOL := TRUE;
    stOverload : ST_ProtectionSet := (eResponse := E_Response.Trip, tDelay := T#100ms, eReset := E_ResetMode.Auto, tRecover := T#10s, nMaxRetries := 3);
    stNoFeedback : ST_ProtectionSet := (eResponse := E_Response.Trip, tDelay := T#3s, eReset := E_ResetMode.Retry, tRecover := T#30s, nMaxRetries := 3);
    stFeedbackLost : ST_ProtectionSet := (eResponse := E_Response.Trip, tDelay := T#500ms, eReset := E_ResetMode.Retry, tRecover := T#30s, nMaxRetries := 3);
    stStuck : ST_ProtectionSet := (eResponse := E_Response.Trip, tDelay := T#3s, eReset := E_ResetMode.Manual, tRecover := T#0s, nMaxRetries := 0);
  END_STRUCT;
END_TYPE
