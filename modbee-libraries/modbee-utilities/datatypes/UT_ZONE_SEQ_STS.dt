TYPE
  UT_ZONE_SEQ_STS : STRUCT
    statusCode : UT_STATUS;
    faultId : UT_FAULT;
    statusText : STRING(30);
    refused : UT_FAULT;
    refusedWhy : UT_FAULT;
    ne107 : UT_NE107;
    stopReason : UT_STOP; (* why the last program ended *)
    lastFaultCode : DWORD;
    lastFault : UT_FAULT;
    trips : UDINT;
    phase : UT_ZONE_PHASE;
    activeZone : INT;
    pass : INT;
    endZone : INT;
    runZone : INT;
    configZone : INT; (* the first zone with a config fault (0 none) *)
    runs : UDINT;
    running : BOOL;
    paused : BOOL;
    waiting : BOOL;
    fault : BOOL;
    warning : BOOL;
    configBad : BOOL;
    doseOn : BOOL;
    masterWanted : BOOL;
    programDelivered : LREAL;
    timeCap : TIME;
  END_STRUCT;
END_TYPE
