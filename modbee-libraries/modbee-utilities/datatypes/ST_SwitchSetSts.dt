TYPE
  ST_SwitchSetSts : STRUCT
    bLowLow : BOOL;
    bLow : BOOL;
    bHigh : BOOL;
    bHighHigh : BOOL;
    bContact : BOOL;
    bGood : BOOL;
    bRefused : BOOL; (* a bad settings write was put back (cleared by a reset) *)
    eRefusedWhy : E_UtError; (* why the last write was refused (cleared with bRefused) *)
    stDisagree : ST_ProtectionSts;
    stInputBad : ST_ProtectionSts;
  END_STRUCT;
END_TYPE
