TYPE
  UT_ANALOG_SET : STRUCT
    signal : UT_AI_SIGNAL; (* 4-20 mA (NE43), 0-20 mA, 0-10 V, custom, direct *)
    rawMin : REAL; (* raw value at the bottom of the signal (4 mA) *)
    rawMax : REAL := 65535.0; (* raw value at the top of the signal (20 mA) *)
    engMin : REAL; (* engineering value at rawMin *)
    engMax : REAL := 100.0; (* engineering value at rawMax *)
    filterTime : TIME; (* low-pass time constant (T#0s = off) *)
    clamp : BOOL := TRUE; (* clamp Value to the engineering range *)
    lowCutoff : REAL; (* values below this read as engMin (0 = off) *)
    customLowFail : REAL := -5.0; (* CUSTOM / DIRECT: fail low at or below this % of span *)
    customHighFail : REAL := 105.0; (* CUSTOM / DIRECT: fail high at or above this % of span *)
    fault : UT_PROTECTION := (response := UT_RESP_TRIP, delay := T#2s, reset := UT_RST_AUTO, recover := T#2s, maxRetries := 3);
    retryWindow : TIME := T#1h;
    faultAction : UT_AI_FAULT; (* value at the pin while BAD: hold, min, max, substitute, pass *)
    substValue : REAL;
    frozen : UT_PROTECTION := (response := UT_RESP_OFF, delay := T#10m, reset := UT_RST_AUTO, recover := T#10s);
    frozenBand : REAL; (* a change larger than this is a change *)
    trimOffset : REAL; (* field zero trim, engineering units *)
    altFactor : REAL := 1.0; (* valueAlt = value * altFactor + altOffset (bar -> psi: 14.5038) *)
    altOffset : REAL;
    unit : UT_UNIT; (* unit of Value *)
  END_STRUCT;
END_TYPE
