TYPE
  UT_STARTS_DATA : STRUCT
    set : UT_STARTS_SET;
    cmdReset : BOOL; (* clear the wait (not the counts) *)
    cmdResetCount : BOOL; (* lifetime and today to 0 *)
    cmdPreset : BOOL;
    presetStarts : UDINT;
    cmdDayRollover : BOOL; (* midnight: today -> yesterday *)
    sts : UT_STARTS_STS;
    permitIn : TIME; (* detail *)
    tot : UT_STARTS_TOT; (* kept hourly *)
  END_STRUCT;
END_TYPE
