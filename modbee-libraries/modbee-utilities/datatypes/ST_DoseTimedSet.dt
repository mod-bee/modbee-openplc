TYPE
  ST_DoseTimedSet EXTENDS ST_DoseSet : STRUCT
    tOnTime : TIME := T#10s; (* dosing on time *)
    tOffTime : TIME := T#5m; (* dosing off time *)
    fPumpSpeedPct : REAL := 100.0; (* % while on *)
    tCarrierProveDelay : TIME := T#10s; (* the carrier must run this long before dosing (waiting, not a fault) *)
  END_STRUCT;
END_TYPE
