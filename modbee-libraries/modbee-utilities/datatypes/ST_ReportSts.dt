TYPE
  ST_ReportSts : STRUCT
    fLastValue : REAL;
    bLastGood : BOOL;
    eReason : E_ReportReason;
    nReports : UDINT;
    nSuppressed : UDINT; (* held back by tMinInterval *)
    tSinceLast : TIME;
    bRefused : BOOL;
    eRefusedWhy : E_UtError; (* why the last write was refused (cleared with bRefused) *)
  END_STRUCT;
END_TYPE
