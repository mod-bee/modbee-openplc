TYPE
  UT_LIMIT_SET : STRUCT
    meas : UT_MEAS := (installed := TRUE, sensor := UT_SENSOR_ANALOG, hiHi := (response := UT_RESP_TRIP, delay := T#2s, reset := UT_RST_AUTO, sp := 90.0, deadband := 1.0), hi := (response := UT_RESP_WARN, delay := T#2s, reset := UT_RST_AUTO, sp := 80.0, deadband := 1.0), lo := (response := UT_RESP_WARN, delay := T#2s, reset := UT_RST_AUTO, sp := 20.0, deadband := 1.0), loLo := (response := UT_RESP_TRIP, delay := T#2s, reset := UT_RST_AUTO, sp := 10.0, deadband := 1.0));
    retryWindow : TIME := T#1h;
    orderCheck : BOOL := TRUE; (* the setpoints in use must be in order *)
  END_STRUCT;
END_TYPE
