TYPE
  UT_PROT_ST : STRUCT
    causeSince : TIME;
    goneSince : TIME;
    windowStart : TIME;
    causePrev : BOOL;
    activePrev : BOOL;
    latched : BOOL;
    needsReset : BOOL;
    beyond : BOOL; (* level: past the setpoint (with deadband) *)
    trip : BOOL; (* results of the last call *)
    warn : BOOL;
    event : BOOL;
    reset : BOOL;
    badSetting : BOOL;
    badInput : BOOL;
    cleared : BOOL; (* an operator reset cleared an AUTO / RETRY latch early (no command cycle) *)
    sig : BOOL; (* SIGNAL response: the level's state *)
  END_STRUCT;
END_TYPE
