TYPE
  ST_AlarmSts : STRUCT
    eIsaState : E_IsaState;
    bActive : BOOL;
    bUnacked : BOOL;
    bQ : BOOL;
    nCount : UDINT;
    tLastDuration : TIME;
    nSequence : UDINT; (* when it was last raised (ms), orders the first-out *)
    dtRaisedAt : DT;
    dtAckedAt : DT;
    dtClearedAt : DT;
    eCode : E_UtError;
    bRefused : BOOL;
    eRefusedWhy : E_UtError; (* why the last write was refused (cleared with bRefused) *)
  END_STRUCT;
END_TYPE
