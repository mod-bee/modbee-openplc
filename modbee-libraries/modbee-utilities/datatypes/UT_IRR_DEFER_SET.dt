TYPE
  UT_IRR_DEFER_SET : STRUCT
    useRain : BOOL := TRUE;
    useSoil : BOOL := TRUE;
    onDelay : TIME := T#1m;
    clearDelay : TIME := T#1h;
    storage : BOOL := TRUE; (* a storage is fitted: ToStorage follows Defer *)
    soilWet : REAL := 35.0; (* Soil transmitter: wet at or above, % *)
    soilDry : REAL := 30.0; (* dry again below *)
    manualDefer : BOOL; (* HMI defer *)
  END_STRUCT;
END_TYPE
