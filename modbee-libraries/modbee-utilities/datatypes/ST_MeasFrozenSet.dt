TYPE
  ST_MeasFrozenSet : STRUCT
    fMinChange : REAL := 0.1; (* a change larger than this is a change *)
    stFrozenFault : ST_ProtectionSet := (eActionOnFault := E_Response.Warn, tTripDelay := T#10m, eResetMode := E_ResetMode.Auto, tAutoRecoverAfter := T#10s, nMaxRetriesBeforeLockout := 3);
    tRetryCountWindow : TIME := T#1h; (* a Retry protection counts its trips within this window (0 = until a reset) *)
  END_STRUCT;
END_TYPE
