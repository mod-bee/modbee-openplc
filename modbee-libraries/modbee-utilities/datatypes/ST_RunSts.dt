TYPE
  ST_RunSts : STRUCT
    eState : E_State;
    eErrorId : E_UtError;
    eStopReason : E_StopReason; (* why the last run ended *)
    bActive : BOOL;
    bPaused : BOOL;
    bWaiting : BOOL; (* a new run waits for the permissive *)
    bRefused : BOOL;
    eRefusedWhy : E_UtError; (* why the last write was refused (cleared with bRefused) *)
  END_STRUCT;
END_TYPE
