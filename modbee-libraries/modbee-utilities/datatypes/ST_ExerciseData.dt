TYPE
  ST_ExerciseData : STRUCT
    bCmdExercise : BOOL; (* run one now (cleared by the block) *)
    set : ST_ExerciseSet;
    bExercising : BOOL; (* status *)
    tNextIn : TIME;
    bRefused : BOOL;
    eRefusedWhy : E_UtError; (* why the last write was refused (cleared with bRefused) *)
  END_STRUCT;
END_TYPE
