(* litres per volume unit (0 = unknown) *)

FUNCTION UT_UNIT_LITRES : LREAL
  VAR_INPUT
    U : UT_UNIT;
  END_VAR

CASE U OF
UT_UNIT_L, UT_UNIT_LPS, UT_UNIT_LPM: UT_UNIT_LITRES := 1.0;
UT_UNIT_M3, UT_UNIT_M3H: UT_UNIT_LITRES := 1000.0;
UT_UNIT_ML: UT_UNIT_LITRES := 1.0E6;
UT_UNIT_GAL, UT_UNIT_GPM: UT_UNIT_LITRES := 3.785411784;
ELSE
  UT_UNIT_LITRES := 0.0;
END_CASE;

END_FUNCTION