FUNCTION UT_CHECK_LREAL : UT_FAULT
  VAR_INPUT
    Value : LREAL;
    MinValue : LREAL;
    MaxValue : LREAL;
  END_VAR

IF NOT (Value = Value) OR Value > 1.7E308 OR Value < -1.7E308 THEN
  UT_CHECK_LREAL := UT_F_VALUE_BAD;
ELSIF MinValue > MaxValue THEN
  UT_CHECK_LREAL := UT_F_LIMITS;
ELSIF Value < MinValue THEN
  UT_CHECK_LREAL := UT_F_BELOW_MIN;
ELSIF Value > MaxValue THEN
  UT_CHECK_LREAL := UT_F_ABOVE_MAX;
ELSE
  UT_CHECK_LREAL := UT_F_NONE;
END_IF;

END_FUNCTION